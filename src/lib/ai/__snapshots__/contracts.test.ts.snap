exports[`contract limits > CompareQuotesRequest 1`] = `
[
  "guestCount: minimum 1, maximum 5000",
  "budgetForCategory: minimum 0, maximum 9007199254740991",
  "quotes: minItems 1, maxItems 4",
  "quotes[].label: minLength 1, maxLength 60",
  "quotes[].text: minLength 20, maxLength 3000",
]
`;

