# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Set one provider key. With none, the app still works using built-in fallbacks.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: which provider to use when both keys are set (gemini or groq).
AI_PROVIDER=

# Optional model overrides.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LITE_MODEL=openai/gpt-oss-20b
