# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Set one provider key. With none, the app still works using built-in fallbacks.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: which provider to use when both keys are set (gemini or groq).
AI_PROVIDER=

# Optional model overrides.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LITE_MODEL=openai/gpt-oss-20b

# Optional: how many X-Forwarded-For entries your own infrastructure appends,
# counted from the right; the client is that entry. Default 1, which suits
# Cloud Run's run.app URL, Vercel or a single reverse proxy. Use 2 behind an
# external Google Cloud load balancer, which appends the client and then itself.
TRUSTED_PROXY_HOPS=

# Optional: Upstash Redis (REST) for rate limits and the AI answer cache, so
# they are shared by every server instance instead of kept per instance.
# Client addresses are hashed before they are stored. Leave empty for memory.
# On Vercel, connecting Upstash from the Marketplace sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead, which are read too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
